	(text "BLUEJAY LAYOUT O — flash O_H_05\nP high-side IRLML2244 on Ac/Bc/Cc (active LOW); N low-side IRLML6244 on Ap/Bp/Cp (active HIGH)\nVBAT = EFM8 VDD (1S only); phase nodes PHASE_A/B/C; gate R = 47R"
		(exclude_from_sim no)
		(at 15 55 0)
